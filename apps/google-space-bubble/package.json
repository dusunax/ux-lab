{
  "name": "google-space-bubble",
  "version": "0.1.0",
  "private": true,
  "description": "Google Chat Space 새 메시지를 데스크톱 말풍선으로 알리는 앱",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
