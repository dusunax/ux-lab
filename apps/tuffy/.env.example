# cortex(LLM) 호출 경로 — apps/openrouter-proxy를 먼저 실행한다 (pnpm --filter openrouter-proxy dev)
MAIN_VITE_CORTEX_URL=http://localhost:3035/api/chat
# 무료 모델만 쓴다 (:free 또는 openrouter/free만 허용). 호출마다 앞에서부터 쓰고, 실패한 모델은 쉬게 한다
# MAIN_VITE_FREE_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# 하루 무료 호출 상한 (기본 40)
# MAIN_VITE_FREE_DAILY_BUDGET=40
# 판단 엔진(무료 LLM / jev)은 콘솔에서 고른다. jev 하루 비용 상한(USD, 기본 0.05)
# MAIN_VITE_JEV_DAILY_USD=0.05

# 음성 인식(whisper.cpp). 비우면 /opt/homebrew/bin/whisper-server, ~/Library/Application Support/tuffy/models/ggml-large-v3-turbo-q5_0.bin
# MAIN_VITE_WHISPER_BIN=
# MAIN_VITE_WHISPER_MODEL=
