<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- 월 표시 (빨간 헤더) -->
    <TextView
        android:id="@+id/widget_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_month_header"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="4dp"
        android:text="1월"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- 일 표시 (큰 숫자). 실제 폰트 크기는 LunarWidgetProvider가 위젯 실제 크기에 맞춰 계산한다 -->
    <!-- paddingBottom은 세로 중앙 기준을 끌어올린다. 폰트가 커진 만큼 옛 12dp 오프셋은 과해서 4dp로 줄였다. -->
    <TextView
        android:id="@+id/widget_day"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="4dp"
        android:gravity="center_horizontal|center_vertical"
        android:textAlignment="center"
        android:text="1"
        android:textColor="@color/text_primary_light"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light" />

</LinearLayout>
