{
  "manifest_version": 3,
  "name": "Smart Screenshot Capture",
  "version": "1.0.1",
  "description": "Capture screenshots with the ability to hide specific HTML elements",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "현재 탭 캡처",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
